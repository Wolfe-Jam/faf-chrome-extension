{
  "manifest_version": 3,
  "name": "Stack⚡️Grabber",
  "version": "1.7.0",
  "description": "The ColorZilla for stacks. Click any repo, get instant stack info. React, n8n, Monaco & more. No cloning, no waiting.",
  
  "icons": {
    "16": "icons/social-logo-16.png",
    "32": "icons/social-logo-32.png",
    "48": "icons/social-logo-48.png",
    "128": "icons/social-logo-128.png"
  },
  
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/social-logo-16.png",
      "32": "icons/social-logo-32.png"
    },
    "default_title": "Stack Grabber - Click to grab this stack"
  },
  
  "background": {
    "service_worker": "service-worker.js"
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  
  "permissions": [
    "activeTab",
    "storage",
    "clipboardWrite",
    "downloads",
    "contextMenus"
  ],
  
  "host_permissions": [
    "https://*/*",
    "http://localhost/*"
  ],
  
  "commands": {
    "extract-context": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Grab stack info instantly"
    }
  },
  
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}