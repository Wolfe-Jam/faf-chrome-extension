{
  "manifest_version": 3,
  "name": "Agent Discovery Check",
  "version": "2.0.1",
  "description": "Checks the site you are on for an AI Catalog, MCP Server Card, llms.txt and WebMCP tools. Reads a site only when you click.",
  "icons": {
    "16": "icons/social-logo-16.png",
    "32": "icons/social-logo-32.png",
    "48": "icons/social-logo-48.png",
    "128": "icons/social-logo-128.png"
  },
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Agent Discovery Check",
    "default_icon": {
      "16": "icons/social-logo-16.png",
      "32": "icons/social-logo-32.png"
    }
  }
}
